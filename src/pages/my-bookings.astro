---
// Eliminamos la verificación del servidor para evitar el rebote
import Layout from '../layouts/Layout.astro';
---

<Layout title="Mis Reservas">
    <div class="max-w-2xl mx-auto mt-8">
        <h1 class="text-3xl font-bold text-white mb-2">Mis Reservas</h1>
        <p class="text-slate-400 mb-8">Gestiona tus próximos partidos.</p>

        <div id="bookings-container" class="space-y-4">
            <p class="text-slate-500 animate-pulse">Cargando tus partidos...</p>
        </div>
    </div>
</Layout>

<script>
    import { supabase } from "../lib/supabase";

    const container = document.getElementById("bookings-container");

    // Función para verificar si la fecha ya pasó
    const isPast = (dateStr: string, timeStr: string) => {
        const bookingDate = new Date(`${dateStr}T${timeStr}`);
        const now = new Date();
        return bookingDate < now;
    };

    const loadBookings = async () => {
        // 1. Obtener usuario en el NAVEGADOR (Aquí sí funciona)
        const { data: { user } } = await supabase.auth.getUser();

        if (!user) {
            window.location.href = "/login"; // Si no hay sesión, al login
            return;
        }

        // 2. Pedir las reservas de este usuario
        const { data: bookings, error } = await supabase
            .from('bookings')
            .select('*, courts(name)')
            .eq('user_id', user.id) // Filtro de seguridad
            .order('date', { ascending: true })
            .order('start_time', { ascending: true });

        if (error) {
            container.innerHTML = `<p class="text-red-400">Error cargando datos: ${error.message}</p>`;
            return;
        }

        // 3. Generar el HTML manualmente (Client-Side Rendering)
        if (!bookings || bookings.length === 0) {
            container.innerHTML = `
                <div class="text-center py-12 bg-slate-800/50 rounded-lg border border-dashed border-slate-700">
                    <p class="text-slate-500 mb-4">No tienes reservas activas.</p>
                    <a href="/" class="bg-green-500 text-slate-900 font-bold py-2 px-4 rounded hover:bg-green-400 transition">
                        Reservar una cancha
                    </a>
                </div>`;
            return;
        }

        // Construimos la lista
        container.innerHTML = bookings.map((item: any) => {
            // 1. Calcular fechas
            const bookingDate = new Date(`${item.date}T${item.start_time}`);
            const now = new Date();
            
            // 2. Calcular diferencia en horas
            const diffInMs = bookingDate.getTime() - now.getTime();
            const diffInHours = diffInMs / (1000 * 60 * 60);

            const passed = diffInHours < 0; // Ya pasó el partido
            const isTooLate = diffInHours < 24 && !passed; // Faltan menos de 24h

            const dateFormatted = new Date(item.date).toLocaleDateString('es-ES', { weekday: 'long', day: 'numeric', month: 'short' });
            
            // Renderizamos
            return `
                <div class="p-4 rounded-lg border flex justify-between items-center transition 
                    ${passed ? 'bg-slate-800/50 border-slate-700 opacity-60' : 'bg-slate-800 border-slate-600'}">
                    
                    <div>
                        <div class="flex items-center gap-2 mb-1">
                            <span class="font-bold text-lg text-white capitalize">${dateFormatted}</span>
                            ${passed ? '<span class="text-xs bg-gray-700 text-gray-400 px-2 py-0.5 rounded">Finalizado</span>' : ''}
                        </div>
                        <p class="text-green-400 font-mono text-lg">
                            ${item.start_time.slice(0,5)} - ${item.end_time.slice(0,5)}
                        </p>
                        <p class="text-sm text-slate-400 mt-1">📍 ${item.courts?.name || 'Cancha'}</p>
                        
                        ${isTooLate ? '<p class="text-xs text-yellow-500 mt-2">⚠️ Menos de 24h para cancelar</p>' : ''}
                    </div>

                    ${!passed && !isTooLate ? `
                        <button 
                            data-id="${item.id}"
                            class="btn-cancel text-sm text-red-400 hover:text-white hover:bg-red-500/20 border border-red-500/30 px-3 py-2 rounded transition"
                        >
                            Cancelar
                        </button>
                    ` : ''}
                    
                    ${isTooLate ? `
                        <button disabled class="text-xs text-slate-500 border border-slate-700 px-3 py-2 rounded cursor-not-allowed opacity-50">
                            Bloqueado
                        </button>
                    ` : ''}

                </div>
            `;
        }).join('');

        // 4. Reconectar los botones de cancelar (Porque el HTML es nuevo)
        attachCancelListeners();
    };

    const attachCancelListeners = () => {
        const buttons = document.querySelectorAll('.btn-cancel');
        buttons.forEach(btn => {
            btn.addEventListener('click', async (e) => {
                const button = e.target as HTMLButtonElement;
                const id = button.dataset.id;
                
                if(confirm("¿Seguro que quieres cancelar este partido? Se liberará el horario.")) {
                    button.textContent = "Cancelando...";
                    button.disabled = true;

                    const { error } = await supabase.from('bookings').delete().eq('id', id);

                    if (!error) {
                        loadBookings(); // Recargamos la lista sin refrescar página
                    } else {
                        alert("Error: " + error.message);
                        button.textContent = "Cancelar";
                        button.disabled = false;
                    }
                }
            });
        });
    };

    // Arrancamos
    loadBookings();
</script>