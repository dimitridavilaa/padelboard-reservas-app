---
// Eliminamos la verificación del servidor para evitar el rebote
import Layout from '../layouts/Layout.astro';
---

<Layout title="Mis Reservas">
    <div class="max-w-3xl mx-auto mt-8 px-4">
        <div class="border-l-4 border-[#3B82f6] pl-4 mb-8">
            <h1 class="text-3xl font-bold text-[#04133E] mb-1">Mis Reservas</h1>
            <p class="text-slate-500">Gestiona tus próximos partidos.</p>
        </div>

        <div id="bookings-container" class="space-y-4">
            <div class="text-center py-10">
                <div class="w-10 h-10 border-4 border-[#04133E] border-t-transparent rounded-full animate-spin mx-auto mb-3"></div>
                <p class="text-slate-400 animate-pulse">Cargando tus partidos...</p>
            </div>
        </div>
    </div>
</Layout>

<script>
    import { supabase } from "../lib/supabase";

    const container = document.getElementById("bookings-container");

    // Función para verificar si la fecha ya pasó
    const isPast = (dateStr: string, timeStr: string) => {
        const bookingDate = new Date(`${dateStr}T${timeStr}`);
        const now = new Date();
        return bookingDate < now;
    };

    const loadBookings = async () => {
        // 1. Obtener usuario en el NAVEGADOR
        const { data: { user } } = await supabase.auth.getUser();

        if (!user) {
            window.location.href = "/login";
            return;
        }

        // 2. Pedir las reservas de este usuario
        const { data: bookings, error } = await supabase
            .from('bookings')
            .select('*, courts(name)')
            .eq('user_id', user.id)
            .order('date', { ascending: true })
            .order('start_time', { ascending: true });

        if (error) {
            container.innerHTML = `<p class="text-red-500 bg-red-50 p-4 rounded border border-red-100">Error cargando datos: ${error.message}</p>`;
            return;
        }

        // 3. Generar el HTML manualmente (Client-Side Rendering)
        if (!bookings || bookings.length === 0) {
            container.innerHTML = `
                <div class="text-center py-16 bg-white rounded-xl border-2 border-dashed border-slate-200">
                    <p class="text-[#04133E] font-medium mb-2 text-lg">No tienes reservas activas.</p>
                    <p class="text-slate-400 text-sm mb-6">¿Te hace falta un partido?</p>
                    <a href="/" class="bg-[#3B82f6] text-white font-bold py-3 px-6 rounded-lg hover:bg-blue-900 transition shadow-lg">
                        Reservar una cancha
                    </a>
                </div>`;
            return;
        }

        // Construimos la lista con ESTILO NUEVO (Blanco/Navy)
        container.innerHTML = bookings.map((item: any) => {
            // 1. Calcular fechas
            const bookingDate = new Date(`${item.date}T${item.start_time}`);
            const now = new Date();
            
            // 2. Calcular diferencia en horas
            const diffInMs = bookingDate.getTime() - now.getTime();
            const diffInHours = diffInMs / (1000 * 60 * 60);

            const passed = diffInHours < 0; // Ya pasó
            const isTooLate = diffInHours < 24 && !passed; // Menos de 24h

            const dateFormatted = new Date(item.date + 'T12:00:00').toLocaleDateString('es-ES', { 
                weekday: 'long', 
                day: 'numeric', 
                month: 'short' 
            });
            
            // Renderizamos con NUEVO DISEÑO
            return `
                <div class="p-6 rounded-2xl border transition group relative overflow-hidden flex flex-col sm:flex-row justify-between items-start sm:items-center gap-6
                    ${passed ? 'bg-slate-50 border-slate-100 opacity-60' : 'bg-white border-slate-200 hover:border-[#3B82f6] hover:shadow-lg shadow-sm'}">
                    
                    <div class="flex-1">
                        <div class="flex items-center gap-4 mb-4">
                            <div class="bg-blue-50 text-[#3B82f6] p-2.5 rounded-xl">
                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-6 h-6">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5" />
                                </svg>
                            </div>
                            <div class="flex flex-col justify-center">
                                <h3 class="font-bold text-xl text-[#04133E] capitalize leading-none tracking-tight">
                                    ${dateFormatted}
                                </h3>
                                
                                ${passed 
                                    ? '<span class="text-[10px] font-bold uppercase tracking-wider text-slate-400 mt-1">Partido Finalizado</span>' 
                                    : '<span class="text-[10px] font-bold uppercase tracking-wider text-[#3B82f6] mt-1">Reserva Confirmada</span>'
                                }
                            </div>
                        </div>
                        
                        <div class="pl-0 sm:pl-[52px]">
                            <div class="flex items-baseline gap-2 mb-1">
                                <span class="text-3xl font-black text-[#04133E]">
                                    ${item.start_time.slice(0,5)}
                                </span>
                                <span class="text-slate-400 font-medium text-sm">a ${item.end_time.slice(0,5)}</span>
                            </div>
                            
                            <div class="inline-flex items-center gap-1.5 bg-slate-100 px-3 py-1 rounded-full border border-slate-200 mt-1">
                                <span class="text-xs">📍</span>
                                <span class="text-xs font-bold text-slate-600 uppercase tracking-wide">
                                    ${item.courts?.name || 'Club Naval'}
                                </span>
                            </div>

                            ${isTooLate ? '<p class="text-xs text-orange-500 mt-3 font-bold flex items-center gap-1">⚠️ Menos de 24h para cancelar</p>' : ''}
                        </div>
                    </div>

                    <div class="w-full sm:w-auto pt-4 sm:pt-0 border-t sm:border-t-0 border-slate-100 mt-2 sm:mt-0 flex sm:block justify-end">
                        ${!passed && !isTooLate ? `
                            <button 
                                data-id="${item.id}"
                                data-date="${item.date}" 
                                data-time="${item.start_time}"
                                data-court="${item.courts?.name || 'Cancha'}"
                                class="btn-cancel w-full sm:w-auto group/btn flex items-center justify-center gap-2 text-sm font-bold text-red-500 hover:text-white bg-red-50 hover:bg-red-500 border border-red-100 hover:border-red-500 px-5 py-3 rounded-xl transition-all"
                            >
                                <span>Cancelar</span>
                            </button>
                        ` : ''}
                        
                        ${isTooLate ? `
                            <div class="w-full sm:w-auto text-center px-4 py-2 bg-slate-50 rounded-lg border border-slate-100">
                                <span class="text-xs font-bold text-slate-400 block">Cancelación</span>
                                <span class="text-xs font-bold text-slate-400 block">Bloqueada</span>
                            </div>
                        ` : ''}
                    </div>

                </div>
            `;
        }).join('');

        // 4. Reconectar los botones de cancelar
        attachCancelListeners();
    };

    const attachCancelListeners = () => {
        const buttons = document.querySelectorAll('.btn-cancel');
        
        buttons.forEach(btn => {
            // Usamos 'btn' directamente para asegurar que referenciamos al botón y no al span interno
            btn.addEventListener('click', async (e) => {
                
                // 1. Recopilar datos ANTES de borrar
                const id = btn.dataset.id;
                const date = btn.dataset.date;
                const time = btn.dataset.time;
                const court = btn.dataset.court;
                
                if(confirm("¿Seguro que quieres cancelar este partido? Se liberará el horario.")) {
                    const originalText = btn.innerHTML;
                    btn.innerHTML = "<span>Procesando...</span>";
                    btn.disabled = true;

                    // 2. Obtener usuario actual (para enviarle el correo)
                    const { data: { user } } = await supabase.auth.getUser();

                    // 3. Borrar de la Base de Datos
                    const { error } = await supabase.from('ngs').delete().eq('id', id);

                    if (!error) {
                        // 4. ✅ ÉXITO: ENVIAR CORREO
                        // (Hacemos el fetch sin await para no bloquear la UI)
                        if (user) {
                             fetch('/api/send-email', {
                                method: 'POST',
                                headers: { 'Content-Type': 'application/json' },
                                body: JSON.stringify({
                                    type: 'cancellation', // <--- Importante: Tipo cancelación
                                    userEmail: user.email,
                                    userName: user.email.split('@')[0],
                                    date: date,
                                    time: time.slice(0,5), // Cortamos los segundos "17:00:00" -> "17:00"
                                    courtName: court
                                })
                            }).catch(err => console.error("Error enviando email cancelación:", err));
                        }

                        // Recargar la lista visualmente
                        loadBookings(); 
                    } else {
                        alert("Error: " + error.message);
                        btn.innerHTML = originalText;
                        btn.disabled = false;
                    }
                }
            });
        });
    };

    loadBookings();
</script>