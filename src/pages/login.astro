---
import '../app.css';
---

<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Acceso Club de Pádel</title>
</head>
<body class="bg-slate-900 text-white flex items-center justify-center h-screen font-sans">
    
    <div class="bg-slate-800 p-8 rounded-lg shadow-xl max-w-sm w-full border border-slate-700">
        <h1 class="text-3xl font-bold mb-2 text-center text-green-400">🎾 Padel App</h1>
        <p class="text-center text-gray-400 mb-6 text-sm">Gestiona tus reservas fácilmente</p>
        
        <form id="auth-form" class="flex flex-col gap-4">
            <div>
                <label class="block text-sm mb-1 text-gray-300">Correo Electrónico</label>
                <input type="email" name="email" required 
                    class="w-full p-2 rounded bg-slate-700 border border-slate-600 text-white focus:border-green-500 focus:ring-1 focus:ring-green-500 outline-none transition" 
                    placeholder="tu@email.com" />
            </div>
            
            <div>
                <label class="block text-sm mb-1 text-gray-300">Contraseña</label>
                <input type="password" name="password" required 
                    class="w-full p-2 rounded bg-slate-700 border border-slate-600 text-white focus:border-green-500 focus:ring-1 focus:ring-green-500 outline-none transition" 
                    placeholder="******" />
            </div>

            <div class="flex flex-col gap-3 mt-2">
                <button type="submit" id="btn-login" 
                    class="bg-green-500 hover:bg-green-600 text-slate-900 font-bold py-2 px-4 rounded transition duration-200 shadow-lg shadow-green-500/20">
                    Iniciar Sesión
                </button>
                
                <button type="button" id="btn-register" 
                    class="bg-transparent border border-gray-500 hover:border-gray-300 text-gray-300 hover:text-white font-semibold py-2 px-4 rounded transition duration-200">
                    Registrarse
                </button>
            </div>
            
            <p id="message" class="text-center text-sm mt-4 min-h-[20px]"></p>
        </form>
    </div>

    <script>
        import { supabase } from "../lib/supabase";

        const form = document.getElementById("auth-form") as HTMLFormElement;
        const btnLogin = document.getElementById("btn-login") as HTMLButtonElement;
        const btnRegister = document.getElementById("btn-register") as HTMLButtonElement;
        const msg = document.getElementById("message") as HTMLParagraphElement;

        // Función para Iniciar Sesión
        form.addEventListener("submit", async (e) => {
            e.preventDefault();
            const formData = new FormData(form);
            const email = formData.get("email") as string;
            const password = formData.get("password") as string;

            msg.textContent = "Ingresando...";
            msg.className = "text-center text-sm mt-4 text-blue-400";

            const { data, error } = await supabase.auth.signInWithPassword({
                email,
                password
            });

            if (error) {
                msg.textContent = "Error: " + error.message;
                msg.className = "text-center text-sm mt-4 text-red-400";
            } else {
                msg.textContent = "✅ ¡Bienvenido!";
                msg.className = "text-center text-sm mt-4 text-green-400";
                setTimeout(() => {
                    window.location.href = "/"; // Ir al calendario (cuando lo creemos)
                }, 1000);
            }
        });

        // Función para Registrarse
        btnRegister.addEventListener("click", async () => {
            const formData = new FormData(form);
            const email = formData.get("email") as string;
            const password = formData.get("password") as string;

            if (!email || !password) {
                msg.textContent = "⚠️ Escribe un correo y contraseña primero";
                msg.className = "text-center text-sm mt-4 text-yellow-400";
                return;
            }

            msg.textContent = "Creando cuenta...";
            msg.className = "text-center text-sm mt-4 text-blue-400";

            const { data, error } = await supabase.auth.signUp({
                email,
                password
            });

            if (error) {
                msg.textContent = "Error: " + error.message;
                msg.className = "text-center text-sm mt-4 text-red-400";
            } else {
                msg.textContent = "✅ ¡Cuenta creada! Ya puedes iniciar sesión.";
                msg.className = "text-center text-sm mt-4 text-green-400";
            }
        });
    </script>
</body>
</html>