---
import Layout from '../layouts/Layout.astro';
import AuthForm from '../components/AuthForm';
---

<Layout title="Acceso - PadelBoard">
  <main class="min-h-screen flex flex-col items-center justify-center p-4 bg-slate-900">
    <div class="mb-8 text-center">
      <h1 class="text-4xl font-bold text-white mb-2 flex items-center justify-center gap-2">
        🎾 PadelClub
      </h1>
      <p class="text-slate-400">Reserva tu cancha en segundos.</p>
    </div>
    
    <AuthForm client:load />

  </main>
</Layout>