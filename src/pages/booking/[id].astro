---
export const prerender = false;
import Layout from '../../layouts/Layout.astro';
import { supabase } from '../../lib/supabase';
import BookingComponent from '../../components/BookingCalendar.jsx'; // 

// 1. Obtener la ID de la URL (ej: si entras a /booking/1, id es "1")
const { id } = Astro.params;

// 2. Traer info de la cancha para poner el título
const { data: court } = await supabase
  .from('courts')
  .select('*')
  .eq('id', id)
  .single();

// Si no existe la cancha, redirigir al home
if (!court) {
  return Astro.redirect('/');
}
---

<Layout title={`Reservar ${court.name}`} userEmail="Usuario">
  <div class="mb-4 animate-fade-in">

    {/* Título Grande */}
    <div class="flex flex-col gap-1">
      <h1 class="text-3xl font-bold text-[#04133E]">
        Reservar:
    </h1>
        <div class="flex items-center gap-3">
             <div class="h-3 w-3 bg-[#3B82f6] rounded-full"></div>
             <h2 class="text-2xl md:text-3xl font-bold text-[#04133E]">
                {court.name}
            </h2>
        </div>
    </div>
</div>

<div class="bg-white p-6 md:p-8 rounded-2xl border border-slate-200 shadow-xl">
  <BookingComponent client:load courtId={id} />
</div>
</Layout>