---
import Layout from '../layouts/Layout.astro';
import { supabase } from '../lib/supabase';

// 1. SEGURIDAD (SSR): Verificamos si hay usuario en el servidor
const { cookies } = Astro;
const accessToken = cookies.get("sb-access-token");
const refreshToken = cookies.get("sb-refresh-token");

// 2. DATOS: Traer las canchas de la Base de Datos
const { data: courts, error } = await supabase
  .from('courts')
  .select('*')
  .eq('is_active', true)
  .order('id');

// Si no hay canchas, mostramos un array vacío
const activeCourts = courts || [];
---

<Layout title="Reservas" userEmail="Usuario">
    
    <div class="mb-8 mt-4 border-l-4 border-[#3B82f6] pl-4">
        <h1 class="text-3xl font-bold text-[#04133E]">Panel de Reservas</h1>
        <p class="text-slate-500">Selecciona una cancha para ver disponibilidad.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {activeCourts.map((court) => (
            <div class="bg-white p-6 rounded-xl border border-slate-200 shadow-sm hover:shadow-md transition cursor-pointer group">
                <div class="flex justify-between items-start">
                    <div>
                        <h2 class="text-xl font-bold text-[#04133E]">{court.name}</h2>
                        <p class="text-sm text-slate-500 mt-1">Cancha de Pádel</p>
                    </div>
                </div>
                
                <a href={`/booking/${court.id}`} class="mt-6 block w-full text-center bg-[#3B82f6] hover:bg-blue-900 text-white py-3 rounded-lg transition font-bold shadow-lg shadow-blue-900/10">
					Ver Calendario
				</a>
            </div>
        ))}

        {activeCourts.length === 0 && (
            <div class="p-6 bg-yellow-50 border border-yellow-200 text-yellow-800 rounded-lg text-center">
                <p class="font-bold">⚠️ No se encontraron canchas activas.</p>
                <p class="text-sm mt-1">Contacta al administrador.</p>
            </div>
        )}
    </div>

</Layout>

<script>
    import { supabase } from "../lib/supabase";

    // Verificación de seguridad en el navegador
    async function checkSession() {
        const { data: { session } } = await supabase.auth.getSession();
        if (!session) {
            // Si no hay sesión, patada al login
            window.location.href = "/login";
        }
    }
    checkSession();
</script>