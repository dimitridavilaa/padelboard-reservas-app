---
import Layout from '../layouts/Layout.astro';
import { supabase } from '../lib/supabase';
import IosInstallPrompt from '../components/IosInstallPrompt.astro';

// 1. SEGURIDAD (SSR): Verificamos si hay usuario en el servidor
const { cookies } = Astro;
const accessToken = cookies.get("sb-access-token");
const refreshToken = cookies.get("sb-refresh-token");

// 2. DATOS: Traer las canchas de la Base de Datos
const { data: courts, error } = await supabase
  .from('courts')
  .select('*')
  .eq('is_active', true)
  .order('id');

// Si no hay canchas, mostramos un array vacío
const activeCourts = courts || [];
---

<Layout title="Reservas" userEmail="Usuario">
    
    <div class="mb-8 mt-4 border-l-4 border-[#3B82f6] pl-4">
        <h1 class="text-3xl font-bold text-[#04133E]">Panel de Reservas</h1>
        <p class="text-slate-500">Selecciona una cancha para ver disponibilidad.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {activeCourts.map((court) => (
            <div class="bg-white p-6 rounded-xl border border-slate-200 shadow-sm hover:shadow-md transition cursor-pointer group">
                <div class="flex justify-between items-start">
                    <div>
                        <h2 class="text-xl font-bold text-[#04133E]">{court.name}</h2>
                        <p class="text-sm text-slate-500 mt-1">Cancha de Pádel</p>
                    </div>
                </div>
                
                {/* BOTÓN CON EFECTO DE CARGA */}
                <a 
                    href={`/booking/${court.id}`} 
                    class="btn-calendar mt-6 flex items-center justify-center gap-2 w-full text-center bg-[#3B82f6] hover:bg-blue-900 text-white py-3 rounded-lg transition font-bold shadow-lg shadow-blue-900/10 active:scale-95 group-hover:shadow-blue-500/20"
                >
                    {/* Texto Normal (Se oculta al hacer click) */}
                    <span class="btn-text">Ver Calendario</span>
                    
                    {/* Estado Cargando (Aparece al hacer click) */}
                    <div class="btn-loader hidden flex items-center gap-2">
                        <svg class="animate-spin h-5 w-5 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                        </svg>
                        <span>Cargando...</span>
                    </div>
				</a>
            </div>
        ))}

        {activeCourts.length === 0 && (
            <div class="p-6 bg-yellow-50 border border-yellow-200 text-yellow-800 rounded-lg text-center">
                <p class="font-bold">⚠️ No se encontraron canchas activas.</p>
                <p class="text-sm mt-1">Contacta al administrador.</p>
            </div>
        )}
    </div>

    <IosInstallPrompt />

</Layout>

<script>
    import { supabase } from "../lib/supabase";

    // Verificación de seguridad en el navegador
    async function checkSession() {
        const { data: { session } } = await supabase.auth.getSession();
        if (!session) {
            window.location.href = "/login";
        }
    }
    checkSession();

    // --- NUEVO: LÓGICA DE BOTONES DE CARGA ---
    // Seleccionamos TODOS los botones de calendario
    const buttons = document.querySelectorAll('.btn-calendar');

    buttons.forEach(btn => {
        btn.addEventListener('click', () => {
            // Buscamos los elementos DENTRO del botón que fue clickeado
            const textSpan = btn.querySelector('.btn-text');
            const loaderDiv = btn.querySelector('.btn-loader');

            // Hacemos el cambio visual
            if (textSpan) textSpan.classList.add('hidden'); // Ocultar "Ver Calendario"
            if (loaderDiv) loaderDiv.classList.remove('hidden'); // Mostrar Spinner

            // Deshabilitar el botón para evitar doble clic y dar efecto visual
            btn.style.opacity = '0.8';
            btn.style.pointerEvents = 'none';
            btn.style.cursor = 'wait';
        });
    });
</script>