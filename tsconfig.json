{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "strict": false,            // <--- Esto apaga el modo "profesor estricto"
    "noImplicitAny": false,     // <--- Permite usar variables sin definir tipo
    "strictNullChecks": false,  // <--- Deja de molestar con los "posibles nulos"
    "jsx": "preserve",
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    }
  }
}